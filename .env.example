# NVIDIA Build (https://build.nvidia.com) API 키. 비워 두면 오프라인 모드(규칙 엔진 + 예시 응답)로 동작합니다.
NVIDIA_API_KEY=

# OpenAI 호환 엔드포인트
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 텍스트 추론 모델 (한국어 품질을 비교해 보고 바꾸세요)
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct

# 서류 사진 판독용 비전 모델
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# 1 로 두면 키가 있어도 LLM을 부르지 않습니다 (시연 안정성용)
FORCE_OFFLINE=0
